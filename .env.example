# ─── Coding Agents — Local Development ────────────────────────────────────────
# Copy to `.env` at the repo root. Symlinks (apps/web/.env, apps/agent/.env)
# point here so every process picks up the same values.

# ─── Database & Redis ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://forge:forge@localhost:5433/forge_app
REDIS_URL=redis://localhost:6380

# ─── GitHub OAuth (primary auth + repo access) ───────────────────────────────
# Create a GitHub OAuth App: https://github.com/settings/developers
# Callback URL: http://localhost:4000/api/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional: a GitHub PAT for server-side operations (webhook registration, etc.)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ─── NextAuth ─────────────────────────────────────────────────────────────────
AUTH_SECRET=                       # Generate with: openssl rand -base64 32
AUTH_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4000

# ─── Admin account (auto-created on first startup) ───────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                    # Choose a strong password

# ─── AI / LLM ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # Required — at least one LLM provider
OPENAI_API_KEY=                    # Optional fallback
# AES-256-GCM key for encrypting user-supplied API keys in the database.
# Must match across coding-agents-web and coding-agents-agent.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Sandbox (isolated code execution) ────────────────────────────────────────
SANDBOX_SERVICE_HOST=localhost:3001
SANDBOX_SHARED_SECRET=             # Shared secret for sandbox auth
SANDBOX_SESSION_SECRET=            # Per-session binding tokens

# ─── CI results callback (optional — e.g. GitHub Actions POST body) ───────────
CI_RUNNER_SECRET=                  # Shared secret for POST /api/ci/results (x-ci-secret header)
RENDER_API_KEY=                    # Render API key (deploy tools; set in production as needed)

# ─── Agent Observability (optional — configures event recording) ─────────────
# Max events recorded per session before capping (default: 10000)
# OBSERVABILITY_EVENT_CAP=10000
# Retention period in days for event data (default: 30)
# OBSERVABILITY_RETENTION_DAYS=30
# Flush interval in ms for event batching (default: 500)
# OBSERVABILITY_FLUSH_INTERVAL_MS=500
# Batch size before auto-flush (default: 20)
# OBSERVABILITY_BATCH_SIZE=20
# Max bytes per metadata field before truncation (default: 4096)
# OBSERVABILITY_METADATA_MAX_BYTES=4096

# ─── Agent Worker (concurrency & behavior) ───────────────────────────────────
# Maximum concurrent agent runs per worker instance (default: 10)
# MAX_CONCURRENT_RUNS=10
# Enable the planning/approval flow before execution (default: false)
# PLANNING_ENABLED=false

# ─── Mirror Sync (idle background refresh) ───────────────────────────────────
# How often to background-refresh mirrors in ms (default: 86400000 = 24h)
# MIRROR_IDLE_SYNC_INTERVAL_MS=86400000

# ─── OpenTelemetry Export (optional — send spans to an OTLP collector) ───────
# Set endpoint to enable OTel export; leave unset to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=render-coding-agents-agent
# Comma-separated key=value pairs for auth headers
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>

# ─── Forgejo (optional — only if using self-hosted git) ──────────────────────
# FORGEJO_INTERNAL_URL=http://localhost:3000
# FORGEJO_EXTERNAL_URL=http://localhost:3000
# FORGEJO_SANDBOX_URL=http://forgejo:3000
# FORGEJO_AGENT_TOKEN=
# FORGEJO_OAUTH_CLIENT_ID=
# FORGEJO_OAUTH_CLIENT_SECRET=
